# Supabase (주문·결제·정산 데이터)
#
# 설정 순서:
#  1. Supabase 프로젝트 생성 (region: Southeast Asia)
#  2. Project Settings > Auth > Third Party Auth > Firebase 추가
#     — 위 NEXT_PUBLIC_FIREBASE_PROJECT_ID 와 반드시 같은 프로젝트를 넣는다
#  3. SQL Editor 에서 supabase/migrations/001 → 002 → 003 → supabase/seed.sql 순서로 실행
#  4. Table Editor > users 에서 본인 uid 행의 role 을 admin 으로 변경 (최초 관리자)
#
# 참고: RLS 정책은 역할(authenticated) 대신 JWT 의 sub 클레임으로 통제하므로
# Firebase 토큰에 role 커스텀 클레임을 넣지 않아도 동작한다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 에뮬레이터 사용 여부 (프로덕션은 false 또는 미설정)
NEXT_PUBLIC_USE_EMULATOR=false

# AI 비전 분석 (서버 사이드 전용)
GOOGLE_AI_API_KEY=
# 또는
OPENAI_API_KEY=
