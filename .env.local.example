# Supabase (주문·결제·정산 데이터)
# Project Settings > Auth > Third Party Auth 에서 위 NEXT_PUBLIC_FIREBASE_PROJECT_ID 와
# 같은 Firebase 프로젝트를 등록해야 RLS 의 auth.uid() 가 Firebase uid 로 매핑된다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 에뮬레이터 사용 여부 (프로덕션은 false 또는 미설정)
NEXT_PUBLIC_USE_EMULATOR=false

# AI 비전 분석 (서버 사이드 전용)
